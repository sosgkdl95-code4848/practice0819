rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 유저 프로필 규칙 (users 컬렉션)
    match /users/{userId} {
      // 로그인한 유저는 자신의 프로필을 읽거나 생성할 수 있음
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // 수정은 본인이거나 관리자(교사)만 가능
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email in ['tmdcjf@asan.cnees.kr', 'dbghwns@asan.cnees.kr']
      );
    }

    // 2. 학급 보드판 및 글로벌 지표 규칙 (classes 컬렉션)
    match /classes/{classId} {
      // 로그인한 학생/교사 누구나 학급 맵 및 지표 읽기 가능
      allow read: if request.auth != null;
      // 타일 배치 및 지표 업데이트는 로그인한 유저만 가능
      allow write: if request.auth != null;
    }
  }
}
